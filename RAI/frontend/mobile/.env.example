# Replace with your local IP address when running on a physical device.
# Example:
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000 # spremeni na svoj ip
EXPO_PUBLIC_MQTT_BROKER_URL=http://192.168.1.100:8000 # spremeni na svoj ip
EXPO_PUBLIC_MQTT_PORT=9001


EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:8000

# Alternative: use a LocalTunnel URL when exposing the backend externally.
# Example:
# EXPO_PUBLIC_API_URL=https://your-backend-url.loca.lt

